# Copy to .env.local (never commit .env.local). Only the variables marked PUBLIC may start with NEXT_PUBLIC_;
# everything else is server-side only and must NEVER be given that prefix.

# ---- Gemini (SECRET) --------------------------------------------------------------------------------------------
GEMINI_API_KEY=
# Lite is the default: ~1 s per call. gemini-flash-latest works but takes ~4-5 s and is often rate-limited or overloaded, which risks the 8 s timeout.
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Cost and abuse guards (server-side, not secret) -------------------------------------------------------------
# Every guard ends in the built-in fallback reader, never in an error: visitors still get a poster, Gemini just isn't asked.
#
# Kill switch. AI_ENABLED=false (also 0, off, no) stops EVERY call to Gemini, for everyone, immediately after a redeploy
# (or as soon as the variable changes on a running server). Unset or anything else means on.
AI_ENABLED=true
# At most this many Gemini calls per server instance per UTC day. Default 500. 0 means none. A value that is not a whole
# number falls back to 500 (never to "unlimited"). It is counted in memory, so on Vercel every warm instance counts for
# itself: it limits a burst, it is not a billing cap. For a hard ceiling, also set a budget alert in Google AI Studio / Cloud.
GEMINI_DAILY_CAP=500
# Per-IP limit (20 requests a minute) is built in and has no setting.
# Set to 1 to skip Gemini and force the deterministic fallback (used by smoke tests)
FORCE_FALLBACK=0

# ---- Site (PUBLIC: shown to every visitor, baked in at build time) -----------------------------------------------
# The public address, for the canonical URL and the share image, e.g. https://stanza.example . Optional on Vercel (the
# production domain is detected), set it when you add a custom domain. Leave empty on localhost.
NEXT_PUBLIC_SITE_URL=
# Anonymous, cookieless page counts with Vercel Web Analytics. Off unless this is exactly "true". Needs Web Analytics
# switched on in the Vercel project; the privacy page changes its wording to match.
NEXT_PUBLIC_ANALYTICS=false
# Optional. A link such as https://buymeacoffee.com/you . Shown once, after a reel is exported. Leave empty to hide it completely.
NEXT_PUBLIC_SUPPORT_URL=
