# Copy to .env.local (never commit .env.local). Server-side only: NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Lite is the default: ~1 s per call. gemini-flash-latest works but takes ~4-5 s and is often rate-limited or overloaded, which risks the 8 s timeout.
GEMINI_MODEL=gemini-flash-lite-latest
# Set to 1 to skip Gemini and force the deterministic fallback (used by smoke tests)
FORCE_FALLBACK=0
# Optional, and PUBLIC on purpose (it is shown to every visitor, so this is the one variable that may start with NEXT_PUBLIC_).
# A link such as https://buymeacoffee.com/you . Shown once, after a reel is exported. Leave empty to hide it completely.
NEXT_PUBLIC_SUPPORT_URL=
