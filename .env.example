# Copy to .env.local (never commit .env.local). Server-side only: NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# gemini-flash-latest works but is slower (~4-5 s) and is often rate-limited or overloaded; gemini-flash-lite-latest answers in ~1 s.
GEMINI_MODEL=gemini-flash-latest
# Set to 1 to skip Gemini and force the deterministic fallback (used by smoke tests)
FORCE_FALLBACK=0
